<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="550.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GerenciarGastosController">
   <top>
      <VBox alignment="CENTER" style="-fx-background-color: #c0392b;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
         </padding>
         <children>
            <Label text="Gerenciar Despesas" textFill="WHITE">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>
         </children>
      </VBox>
   </top>
   
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <VBox spacing="10.0" style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-radius: 5;">
               <padding>
                  <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
               </padding>
               <children>
                  <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Descrição do Gasto:" />
                              <TextField fx:id="txtNomeGasto" promptText="Ex: Aluguel, Sabão, Luz..." />
                           </children>
                        </VBox>
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Valor (R$):" />
                              <TextField fx:id="txtValorGasto" prefWidth="100.0" promptText="0.00" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Data:" />
                              <DatePicker fx:id="dpDataGasto" prefWidth="130.0" />
                           </children>
                        </VBox>
                        <Button fx:id="btnSalvar" mnemonicParsing="false" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="➕ Salvar">
                           <font><Font name="System Bold" size="13.0" /></font>
                           <padding>
                              <Insets bottom="7.0" left="15.0" right="15.0" top="7.0" />
                           </padding>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <TableView fx:id="tabelaGastos" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colunaDescricao" prefWidth="300.0" text="Descrição" />
                <TableColumn fx:id="colunaData" prefWidth="120.0" text="Data" />
                <TableColumn fx:id="colunaValor" prefWidth="120.0" text="Valor (R$)" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="btnExcluir" mnemonicParsing="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="🗑️ Excluir Selecionado">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="btnEditarGasto" mnemonicParsing="false" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="✏ Editar">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>
         <children>
            <Button fx:id="btnConcluir" mnemonicParsing="false" style="-fx-background-color: #2c3e50; -fx-text-fill: white;" text="Fechar Janela">
               <padding>
                  <Insets bottom="8.0" left="25.0" right="25.0" top="8.0" />
               </padding>
               <font><Font name="System Bold" size="13.0" /></font>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>
