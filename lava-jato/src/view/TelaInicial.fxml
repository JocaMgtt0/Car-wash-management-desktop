<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TelaInicialController">
   <top>
      <VBox alignment="CENTER" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label text="Minhas Agendas" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   
   <center>
      <VBox BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
               <padding>
                  <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
               </padding>
               <children>
                  <Label text="Buscar por nome:">
                     <font><Font size="13.0" /></font>
                  </Label>
                  <TextField fx:id="txtFiltroNome" promptText="Digite o nome da agenda..." prefWidth="250.0" />
                  <Label text="Filtrar por data:">
                     <font><Font size="13.0" /></font>
                  </Label>
                  <DatePicker fx:id="dpFiltroData" promptText="Selecione uma data" />
                  <Button fx:id="btnLimparFiltro" mnemonicParsing="false" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Limpar Filtro">
                     <font><Font size="13.0" /></font>
                     <padding><Insets bottom="5.0" left="10.0" right="10.0" top="5.0" /></padding>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="tabelaAgendas" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colunaNome" prefWidth="300.0" text="Nome da Agenda" />
                  <TableColumn fx:id="colunaData" prefWidth="150.0" text="Data" />
                  <TableColumn fx:id="colunaTotal" prefWidth="150.0" text="Total Arrecadado (R$)" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>

	<bottom>
      <HBox alignment="CENTER_RIGHT" spacing="20.0" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label text="Receita Total (Todas as Agendas):">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            
            <Label fx:id="labelTotalGeral" text="R$ 0,00" textFill="#27ae60">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            
            <Pane HBox.hgrow="ALWAYS" />
            
            <Button fx:id="btnExcluirAgenda" mnemonicParsing="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="🗑 Excluir Agenda">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </Button>

            <Button fx:id="btnEditarAgenda" mnemonicParsing="false" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="✏ Editar Agenda">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </Button>
            
            <Button fx:id="btnFechamento" mnemonicParsing="false" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="📊 Fechamento do Mês">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </Button>
            
            <Button fx:id="btnCriarAgenda" mnemonicParsing="false" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="➕ Criar Nova Agenda">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>
