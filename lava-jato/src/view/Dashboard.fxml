<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">
   <top>
      <VBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label text="Controle de Lavagens" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label fx:id="labelTitulo" text="Agenda: Nome da Agenda" textFill="#bdc3c7">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   
   <center>
      <VBox BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <TableView fx:id="tabelaLavagens" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colunaModelo" prefWidth="250.0" text="Modelo do Veículo" />
                <TableColumn fx:id="colunaPlaca" prefWidth="150.0" text="Placa do Veículo" />
                <TableColumn fx:id="colunaValor" prefWidth="120.0" text="Valor (R$)" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </center>

   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <VBox alignment="CENTER_LEFT">
               <children>
                  <Label text="Receita do Dia:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="labelTotal" text="R$ 0,00" textFill="#27ae60">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <Pane HBox.hgrow="ALWAYS" />
            
            <Button fx:id="btnVoltar" mnemonicParsing="false" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Voltar">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </Button>

            <Button fx:id="btnEditarLavagem" mnemonicParsing="false" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="✏ Editar Lavagem">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </Button>

            <Button fx:id="btnExcluirLavagem" mnemonicParsing="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" text="🗑 Excluir Lavagem">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </Button>
            
            <Button fx:id="btnNovaLavagem" mnemonicParsing="false" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="➕ Nova Lavagem">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>