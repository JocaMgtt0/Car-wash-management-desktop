<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FechamentoMesController">
   
   <top>
      <VBox alignment="CENTER" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Label text="📊 Dashboard Financeiro - Fechamento" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Mês:">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <ComboBox fx:id="comboFiltroMes" prefWidth="150.0" style="-fx-font-size: 14px;" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Ano:">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <ComboBox fx:id="comboFiltroAno" prefWidth="120.0" style="-fx-font-size: 14px;" />
                     </children>
                  </VBox>
                  
                  <Pane HBox.hgrow="ALWAYS" />
                  
                  <Button fx:id="btnNovoGasto" mnemonicParsing="false" style="-fx-background-color: #c0392b; -fx-text-fill: white;" text="💸 Registrar Gasto no Mês">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                     </padding>
                  </Button>
               </children>
            </HBox>
            
            <HBox spacing="15.0">
               <children>
                  <VBox alignment="CENTER" prefHeight="110.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #2980b9; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Receita Bruta" textFill="#2980b9">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <Label fx:id="labelReceitaMes" text="R$ 0,00" textFill="#2c3e50">
                           <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                     </children>
                  </VBox>
                  
                  <VBox alignment="CENTER" prefHeight="110.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #c0392b; -fx-border-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Total Gastos" textFill="#c0392b">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <Label fx:id="labelTotalGastos" text="R$ 0,00" textFill="#c0392b">
                           <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                     </children>
                  </VBox>

                  <VBox alignment="CENTER" prefHeight="110.0" style="-fx-background-color: #27ae60; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Lucro Líquido" textFill="WHITE">
                           <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <Label fx:id="labelLucroLiquido" text="R$ 0,00" textFill="WHITE">
                           <font><Font name="System Bold" size="30.0" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <Label text="Detalhamento das Agendas:">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            
            <TableView fx:id="tabelaAgendasFiltradas" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colunaData" prefWidth="150.0" text="Data" />
                <TableColumn fx:id="colunaNome" prefWidth="400.0" text="Nome da Agenda" />
                <TableColumn fx:id="colunaValor" prefWidth="200.0" text="Total Arrecadado (R$)" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
         </children>
      </VBox>
   </center>
   
   <bottom>
      <HBox alignment="CENTER_RIGHT" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
         <children>
            <Button fx:id="btnVoltar" mnemonicParsing="false" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="⬅ Voltar para o Início">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
               </padding>
            </Button>
         </children>
      </HBox>
   </bottom>
</BorderPane>